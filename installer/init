#!/bin/busybox sh

export PATH=/bin

/bin/busybox mkdir -p /proc /sys /dev
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev

# symlink all busybox tools in path
/bin/busybox --install -s /bin

# Load the drivers for the hardware in this machine. Every device the kernel finds has a modalias file
# in /sys (e.g. pci:v00008086d000010D3...); modprobe matches it against modules.alias to find the driver.
# Some drivers reveal more devices (the USB controller, then the USB disk and keyboard behind it;
# virtio_pci, then the virtio disk and network card), so repeat a few times.
load_drivers() {
  for pass in 1 2 3; do
    find /sys/devices -name modalias -exec cat {} + 2>/dev/null | sort -u | xargs modprobe -a -q 2>/dev/null
    sleep 1
  done
}
load_drivers
# No modalias asks for these, so load them by name (built into the kernel on some targets, which is fine):
# af_packet: raw packet sockets, which udhcpc needs to send DHCP.
# i8042, atkbd: the PS/2 keyboard controller and keyboard (x86 only). The controller is found through ACPI,
# whose modalias doesn't match the driver's, so it isn't loaded above.
for m in af_packet i8042 atkbd; do
  modprobe "$m" 2>/dev/null
done

# UEFI boot entries (Boot0001, BootOrder, ...) show up as files here; only exists on UEFI machines
if [ -d /sys/firmware/efi ]; then
  modprobe efivarfs 2>/dev/null  # may be built into the kernel instead, which is fine
  mount -t efivarfs efivarfs /sys/firmware/efi/efivars || echo "haos-netinstall: failed to mount efivarfs"
fi

# Initialize nic
mkdir -p /etc
ip link set lo up

# Print the network interfaces (eth0, enp3s0, ...), skipping loopback
interfaces() {
  for dev in /sys/class/net/*; do
    [ "${dev##*/}" = lo ] || echo "${dev##*/}"
  done
}

# Succeed if a cable is plugged into the interface (carrier is only readable while it's up)
has_carrier() {
  [ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null)" = 1 ]
}

for iface in $(interfaces); do
  ip link set "$iface" up
done

# A real network card takes a few seconds to notice the cable after coming up; wait up to 10s for one to
wait=0
while [ "$wait" -lt 10 ]; do
  for iface in $(interfaces); do
    has_carrier "$iface" && break 2
  done
  sleep 1
  wait=$((wait + 1))
done

# DHCP on the first interface with a cable that gets an answer. The script configures the address,
# route and DNS.
net=
for iface in $(interfaces); do
  has_carrier "$iface" || continue
  if udhcpc -i "$iface" -s /usr/share/udhcpc/default.script -q -t 5 -n; then
    net=$iface
    break
  fi
done
[ -n "$net" ] || echo "haos-netinstall: DHCP failed (interfaces: $(interfaces | tr '\n' ' '))"

# Configure TLS bundle
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# TODO: Use DHCP reply ntp (udhcpc -O ntpsrv …) via $ntpsrv
timeout 20 ntpd -q -n -p pool.ntp.org || echo "haos-netinstall: WARNING: time sync failed; HTTPS may fail"

/usr/bin/haos-netinstall
status=$?

if [ "$status" -eq 0 ]; then
  echo "haos-netinstall: done, rebooting into Home Assistant OS"
  sleep 5
  reboot -f
fi

# PID 1 must never exit (the kernel panics), so drop to a shell instead
echo "haos-netinstall: failed (exit $status). Dropping to a rescue shell."
exec setsid cttyhack sh
